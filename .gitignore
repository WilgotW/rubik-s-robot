# ------------------------------------
# General Project Files to Ignore
# ------------------------------------
# Python files/folders
__pycache__/
*.pyc
/venv/
.env

# Text editor / IDE specific files (e.g., VS Code)
.vscode/

# ------------------------------------
# KiCad Files to IGNORE (Located in /KiCad/)
# ------------------------------------
# Project Local Settings (User-specific settings)
/KiCad/*.kicad_prl

# Lock files (Temporary access control)
/KiCad/*.lck

# Backup folder (Generated by KiCad)
/KiCad/rubiks-cub-backups/

# Session files (Stores view, layer visibility, etc.)
/KiCad/*.kicad_session

# Generic temp files
/KiCad/*~

# Manufacturing outputs (Gerbers, Drill files, BOMs, etc.)
# IMPORTANT: Only generate these locally and manually commit them if you need
# to send them to a manufacturer, but do not track them here.
/KiCad/gerbers/
/KiCad/plots/
/KiCad/*.gbr
/KiCad/*.drl
/KiCad/*.pos
/KiCad/*.rpt